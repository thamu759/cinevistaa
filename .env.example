# Server configuration
PORT=5000
# Optional: MongoDB connection string
# MONGO_URI=mongodb://localhost:27017/midnight_cinema

# TMDB credentials (either of these)
# - TMDB_API_KEY: legacy API key (v3). Some endpoints accept api_key query param.
# - TMDB_ACCESS_TOKEN: v4 bearer token for higher limits and write operations.
TMDB_API_KEY=
# TMDB_ACCESS_TOKEN=

# Optional: override image base URL (defaults to https://image.tmdb.org/t/p)
# TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
