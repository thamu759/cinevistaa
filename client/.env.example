# API base URL. Leave unset to auto-detect (localhost in dev, same-origin /api in production)
# VITE_API_URL=http://localhost:5000/api

# Google Sign-In client ID (optional) — shows "Continue with Google" button in the login modal.
# Create an OAuth 2.0 Web client at https://console.cloud.google.com/apis/credentials
# and add your site origin to "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
